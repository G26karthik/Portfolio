---
import '@fontsource/gloock';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import gloock from '@fontsource/gloock/files/gloock-latin-400-normal.woff2?url';
import { getCollection } from 'astro:content';
import { profile, links, socials } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  shape?: string;
  og?: string;
  jsonld?: object;
  calm?: boolean; // reading pages: the field stays almost invisible
}

const { title, description = profile.description, shape = 'noise', og = 'home', jsonld, calm } = Astro.props;
const path = Astro.url.pathname;
const home = path === '/';
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.role}`;
const canonical = new URL(path, Astro.site).href;
const image = new URL(`/og/${og}.png`, Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  telephone: profile.tel,
  url: new URL('/', Astro.site).href,
  sameAs: Object.values(links),
};
const ld = [person, ...(jsonld ? [jsonld] : [])];

const nav = [
  ['Projects', '/projects', '/work'], ['Experience', '/experience'], ['Open source', '/open-source'],
  ['Research', '/research'], ['Achievements', '/achievements'], ['Writing', '/writing'],
].map(([label, href, also]) => ({ label, href, on: path.startsWith(href) || (!!also && path.startsWith(also)) }));
const sheet = [{ label: 'Home', href: '/', on: home }, ...nav, { label: 'Certifications', href: '/achievements#certifications', on: false }];

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const posts = await getCollection('writing');
const pages = [
  ['Home', '/'], ['Projects', '/projects'], ['Experience', '/experience'], ['Open source', '/open-source'],
  ['Research', '/research'], ['Achievements', '/achievements'], ['Writing', '/writing'], ['Certifications', '/achievements#certifications'], ['Contact', '/#contact'],
];
const commands = [
  ...work.map((w) => ({ label: w.data.title, hint: w.data.kind === 'case' ? 'Case study' : 'Product', href: `/work/${w.id}/` })),
  ...posts.map((p) => ({ label: p.data.title, hint: 'Post', href: `/writing/${p.id}/` })),
  ...pages.map(([label, href]) => ({ label, hint: 'Page', href })),
  ...socials.map((s) => ({ label: s.label, hint: 'Profile', href: s.href })),
  { label: 'Email me', hint: 'Contact', href: `mailto:${profile.email}` },
  { label: `Call ${profile.phone}`, hint: 'Contact', href: `tel:${profile.tel}` },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#faf6ee" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {[geist, gloock].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>(() => { const d = document.documentElement; d.classList.add('js'); try { if (localStorage.getItem('theme') === 'dark') { d.dataset.theme = 'dark'; document.querySelector('meta[name=theme-color]').content = '#0a0f0d'; } } catch { /* no storage: stay light */ } })();</script>
  </head>
  <body data-shape={shape} data-attract={home ? '1' : undefined} data-calm={calm ? '1' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    <canvas id="field" aria-hidden="true"></canvas>
    <div class="cursor" aria-hidden="true"><span class="cdot"></span><span class="ring"></span></div>

    <header class="nav">
      <div class="wrap nav-in">
        <a class="mark" href="/">{profile.name}</a>
        <nav class="links" aria-label="Primary">
          {nav.map((n) => <a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <div class="tools">
          <button type="button" class="ask-btn" data-palette-open aria-label="Ask about my work">Ask <kbd>Ctrl&nbsp;K</kbd></button>
          <button type="button" class="icon-btn" data-theme-toggle aria-label="Dark theme" aria-pressed="false">
            <svg class="i-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="i-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
          <button type="button" class="menu-btn" data-menu-open aria-haspopup="dialog">Menu</button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="wrap foot">
      <p class="big" aria-hidden="true">{profile.name}</p>
      <div class="foot-row">
        <p>© 2026 {profile.name}, {profile.location}</p>
        <nav aria-label="Profiles">
          {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={`tel:${profile.tel}`}>{profile.phone}</a>
        </nav>
      </div>
    </footer>

    <dialog class="sheet" data-menu aria-label="Menu">
      <button type="button" class="close" data-menu-close>Close</button>
      {sheet.map((t) => <a href={t.href} aria-current={t.on ? 'page' : undefined}>{t.label}</a>)}
      <div class="socials">{socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</div>
    </dialog>

    <dialog class="palette" data-palette aria-label="Search or ask">
      <div class="bar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-label="Search the site or ask a question" placeholder="Search, or ask a question about my work" autocomplete="off" spellcheck="false" />
      </div>
      <div class="answer" data-answer hidden aria-live="polite"></div>
      <ul role="listbox" id="palette-list"></ul>
      <div class="hint"><span>↑↓ move</span><span>↵ open or ask</span><span>esc close</span></div>
    </dialog>

    <script is:inline type="application/json" id="commands" set:html={JSON.stringify(commands)} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
