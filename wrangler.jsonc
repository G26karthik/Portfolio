{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "ASK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "routes": [
    { "pattern": "g26karthik.dev", "custom_domain": true },
    { "pattern": "www.g26karthik.dev", "custom_domain": true }
  ]
}
